# Supabase (browser — VITE_ prefix only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase (server / edge functions — never expose in frontend)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin & brand (browser-safe)
ADMIN_EMAIL=jawrahpixel@gmail.com
VITE_ADMIN_EMAIL=
VITE_BRAND_INSTAGRAM=
VITE_BRAND_WHATSAPP=

# Resend email (server / Vercel Functions only — never expose in frontend)
RESEND_API_KEY=
FROM_EMAIL=projects@jawrahpixel.com

# Legacy SMTP placeholders (server / edge functions only)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Sri Lanka payments (server only)
PAYHERE_MERCHANT_ID=
PAYHERE_SECRET=
PAYHERE_MERCHANT_SECRET=
ONEPAY_API_KEY=

# Pakistan payments (server only)
EASYPAISA_API_KEY=
JAZZCASH_API_KEY=

# International payments (server only; public key is optional in browser)
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
VITE_STRIPE_PUBLIC_KEY=
# Optional: set when Stripe publishable key is configured for client-side checkout hints
WISE_API_KEY=
PAYONEER_API_KEY=

# AI
VITE_GEMINI_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
STABILITY_API_KEY=

# Vercel: map each variable above in Project Settings → Environment Variables.
# Never add RESEND_API_KEY, FROM_EMAIL, SUPABASE_SERVICE_ROLE_KEY, or SMTP_* to VITE_ prefixed keys.
